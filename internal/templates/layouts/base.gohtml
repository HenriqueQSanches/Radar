{{define "layouts/base.gohtml"}}
<!DOCTYPE html>
<html data-theme="sombra" lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="page-title">{{.Title}}</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">

    <link rel="stylesheet" href="/styles/tailwind.css">

    <script src="/scripts/vendors/lucide.min.js"></script>

    <link rel="stylesheet" href="/styles/app.css">
    <link rel="stylesheet" href="/styles/components.css">


    <!-- Must be defined before modules -->
    <script>
        window.onGlobalsReady = function(callback) {
            if (window.__globalsReady) {
                callback();
            } else {
                document.addEventListener('globalsReady', callback, { once: true });
            }
        };
    </script>

    <script type="module">
        import { CATEGORIES } from '/scripts/constants/LoggerConstants.js';
        import settingsSync from '/scripts/utils/SettingsSync.js';
        import i18n from '/scripts/utils/i18n.js';
        import {
            attachCheckboxListeners,
            generateResourceGrid,
            initializeTierButtonStates,
            updateTierButtonState,
            selectAllTierEnchants,
            getResourceStorageKey
        } from '/scripts/utils/ResourcesHelper.js';

        window.CATEGORIES = CATEGORIES;
        window.settingsSync = settingsSync;
        window.i18n = i18n;
        window.ResourcesHelper = {
            attachCheckboxListeners,
            generateResourceGrid,
            initializeTierButtonStates,
            updateTierButtonState,
            selectAllTierEnchants,
            getResourceStorageKey
        };

        window.__globalsReady = true;
        document.dispatchEvent(new CustomEvent('globalsReady'));

        // Re-translate whatever page content HTMX just swapped in, and the very first
        // paint before any navigation happens.
        i18n.applyTranslations();
        document.body.addEventListener('htmx:afterSwap', (e) => {
            if (e.detail.target) i18n.applyTranslations(e.detail.target);
        });

        function bindLangButtons(root) {
            root.querySelectorAll('.lang-btn').forEach(btn => {
                btn.addEventListener('click', () => i18n.setLanguage(btn.dataset.lang));
            });
        }
        bindLangButtons(document);

    </script>

    <script type="module" src="/scripts/logger.js"></script>
    <script type="module" src="/scripts/core/PageController.js"></script>
    <script type="module" src="/scripts/utils/Toast.js"></script>
    <script type="module" src="/scripts/utils/Modal.js"></script>
    <script src="/scripts/vendors/htmx.min.js"></script>

    <!-- Must be in head before sidebar template -->
    <script>
        // Desktop sidebar is a fixed-width compact icon rail (see sidebar.gohtml) — no
        // expand/collapse state to track any more. Only the mobile slide-out menu needs JS.
        window.sidebar = {
            init() {
                if (window.lucide) lucide.createIcons();
            },

            openMobile() {
                document.body.classList.add('mobile-menu-open');
            },

            closeMobile() {
                document.body.classList.remove('mobile-menu-open');
            }
        };
    </script>

</head>
<body class="bg-base-100 text-base-content font-display">
    <div class="flex h-screen">
        {{template "layouts/sidebar.gohtml" .}}

        <div class="flex-1 flex flex-col overflow-hidden">
            {{template "layouts/header.gohtml" .}}

            <main id="page-content"
                  class="flex-1 overflow-y-auto p-2 sm:p-6 bg-base-100"
                  data-page="{{.Page}}"
                  hx-swap="innerHTML"
                  hx-swap-oob="true">
                <div class="container mx-auto">
                    {{if eq .Page "radar"}}{{template "pages/radar" .}}
                    {{else if eq .Page "players"}}{{template "pages/players" .}}
                    {{else if eq .Page "resources"}}{{template "pages/resources" .}}
                    {{else if eq .Page "enemies"}}{{template "pages/enemies" .}}
                    {{else if eq .Page "chests"}}{{template "pages/chests" .}}
                    {{else if eq .Page "settings"}}{{template "pages/settings" .}}
                    {{else if eq .Page "about"}}{{template "pages/about" .}}
                    {{else}}{{template "pages/radar" .}}{{end}}
                </div>

                {{if eq .Page "radar"}}{{template "scripts/radar" .}}
                {{else if eq .Page "players"}}{{template "scripts/players" .}}
                {{else if eq .Page "resources"}}{{template "scripts/resources" .}}
                {{else if eq .Page "enemies"}}{{template "scripts/enemies" .}}
                {{else if eq .Page "chests"}}{{template "scripts/chests" .}}
                {{else if eq .Page "settings"}}{{template "scripts/settings" .}}
                {{end}}
            </main>
        </div>
    </div>

    <div id="mobile-overlay"
         onclick="window.sidebar.closeMobile()"
         class="mobile-menu-overlay fixed inset-0 z-30 bg-black/50 md:hidden">
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => window.sidebar.init());

        // Page lifecycle cleanup - prevents memory leaks on navigation
        document.addEventListener('htmx:beforeSwap', (e) => {
            if (e.detail.target?.id === 'page-content') {
                // Dispatch cleanup event for page scripts to unregister listeners
                document.dispatchEvent(new CustomEvent('pageCleanup'));
            }
        });

        // Only create icons within swapped content (not globally)
        document.addEventListener('htmx:afterSwap', (e) => {
            if (e.detail.target && window.lucide) {
                // Defer icon creation to next frame to avoid blocking
                requestAnimationFrame(() => {
                    lucide.createIcons({ nodes: [e.detail.target] });
                });
            }
        });


        // Update sidebar active state on navigation. Nav items carry their full visual
        // styling as static classes already (see sidebar.gohtml) — this only flips the
        // one class that marks which item is current, so it works the same for the
        // desktop icon rail and the mobile text list.
        document.addEventListener('htmx:pushedIntoHistory', (_e) => {
            const currentPath = window.location.pathname;

            document.querySelectorAll('#desktop-nav a, #mobile-nav a').forEach(link => {
                link.classList.toggle('active', link.getAttribute('href') === currentPath);
            });
        });
    </script>
</body>
</html>
{{end}}
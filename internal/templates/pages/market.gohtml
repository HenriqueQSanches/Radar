{{define "pages/market"}}
<div class="space-y-6 stagger">
    <!-- Page Header -->
    <div class="card bg-base-200">
        <div class="card-body">
            <div>
                <h1 data-i18n="market.title" class="text-3xl font-bold text-base-content">Market</h1>
                <p data-i18n="market.subtitle" class="text-base-content/60 mt-2">
                    Sell prices in Thetford, Fort Sterling, Lymhurst, Bridgewatch, Martlock and Caerleon,
                    via the Albion Online Data Project.
                </p>
            </div>
        </div>
    </div>

    <!-- Market Route Section -->
    <div id="marketRouteSection" class="card bg-base-200">
        <div class="card-body">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <h3 data-i18n="market.route.title" class="text-xl font-semibold text-base-content">Market Route</h3>
                <div class="flex gap-2">
                    <button id="calcRouteBtn" data-i18n="market.route.calcBtn" class="btn btn-primary btn-sm">Calculate Route</button>
                    <button id="calcCitiesBtn" data-i18n="market.route.citiesBtn" class="btn btn-outline btn-sm">Best City</button>
                </div>
            </div>
            <p data-i18n="market.route.description" class="text-xs text-base-content/50 mt-1">
                Sell price of raw resources (T2-T8, including T4.1-T8.1).
                "Best City" uses the same data, grouped by overall city average.
            </p>
            <div id="marketRouteFilters" class="flex flex-wrap items-center gap-3 mt-3 hidden">
                <label class="flex items-center gap-1.5 text-xs text-base-content/60">
                    <span data-i18n="market.route.resourceLabel">Resource:</span>
                    <select id="marketRouteResourceFilter" class="select select-bordered select-xs">
                        <option value="" data-i18n="market.route.all">All</option>
                        <option value="Madeira" data-i18n="market.resource.wood">Wood</option>
                        <option value="Pedra" data-i18n="market.resource.stone">Stone</option>
                        <option value="Fibra" data-i18n="market.resource.fiber">Fiber</option>
                        <option value="Couro" data-i18n="market.resource.hide">Hide</option>
                        <option value="Minério" data-i18n="market.resource.ore">Ore</option>
                    </select>
                </label>
                <label class="flex items-center gap-1.5 text-xs text-base-content/60">
                    <span data-i18n="market.route.tierLabel">Tier:</span>
                    <select id="marketRouteTierFilter" class="select select-bordered select-xs">
                        <option value="" data-i18n="market.route.all">All</option>
                        <option value="2.0">T2</option>
                        <option value="3.0">T3</option>
                        <option value="4.0">T4</option>
                        <option value="4.1">T4.1</option>
                        <option value="5.0">T5</option>
                        <option value="5.1">T5.1</option>
                        <option value="6.0">T6</option>
                        <option value="6.1">T6.1</option>
                        <option value="7.0">T7</option>
                        <option value="7.1">T7.1</option>
                        <option value="8.0">T8</option>
                        <option value="8.1">T8.1</option>
                    </select>
                </label>
            </div>
            <div id="marketRouteStatus" class="text-sm text-base-content/60 mt-3 hidden"></div>
            <div id="marketRouteResults" class="mt-3 overflow-x-auto hidden">
                <table class="table table-zebra table-sm">
                    <thead>
                        <tr>
                            <th data-i18n="market.table.resource">Resource</th>
                            <th data-i18n="market.table.price">Price</th>
                            <th data-i18n="market.table.city">City</th>
                        </tr>
                    </thead>
                    <tbody id="marketRouteTableBody"></tbody>
                </table>
            </div>
            <div id="bestCitiesStatus" class="text-sm text-base-content/60 mt-3 hidden"></div>
            <div id="bestCitiesResults" class="mt-3 overflow-x-auto hidden">
                <table class="table table-zebra table-sm">
                    <thead>
                        <tr>
                            <th data-i18n="market.table.city">City</th>
                            <th data-i18n="market.table.cityAvgPrice">Average price</th>
                            <th data-i18n="market.table.samples">Samples</th>
                        </tr>
                    </thead>
                    <tbody id="bestCitiesTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Fish Hotspots Section -->
    <div id="fishHotspotsSection" class="card bg-base-200">
        <div class="card-body">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <h3 data-i18n="market.fish.title" class="text-xl font-semibold text-base-content">Fish</h3>
                <button id="calcFishBtn" data-i18n="market.fish.calcBtn" class="btn btn-primary btn-sm">Search Fish</button>
            </div>
            <p data-i18n="market.fish.description" class="text-xs text-base-content/50 mt-1">
                Sell price of fish (T4-T8).
            </p>
            <div id="fishFilters" class="flex flex-wrap items-center gap-3 mt-3 hidden">
                <label class="flex items-center gap-1.5 text-xs text-base-content/60">
                    <span data-i18n="market.fish.label">Fish:</span>
                    <select id="fishResourceFilter" class="select select-bordered select-xs">
                        <option value="" data-i18n="market.route.all">All</option>
                        <option value="Peixe de Água Doce" data-i18n="market.fish.freshwater">Freshwater</option>
                        <option value="Peixe de Água Doce Raro" data-i18n="market.fish.freshwaterRare">Freshwater Rare</option>
                        <option value="Peixe de Água Salgada" data-i18n="market.fish.saltwater">Saltwater</option>
                        <option value="Peixe de Água Salgada Raro" data-i18n="market.fish.saltwaterRare">Saltwater Rare</option>
                    </select>
                </label>
                <label class="flex items-center gap-1.5 text-xs text-base-content/60">
                    <span data-i18n="market.route.tierLabel">Tier:</span>
                    <select id="fishTierFilter" class="select select-bordered select-xs">
                        <option value="" data-i18n="market.route.all">All</option>
                        <option value="4">T4</option>
                        <option value="5">T5</option>
                        <option value="6">T6</option>
                        <option value="7">T7</option>
                        <option value="8">T8</option>
                    </select>
                </label>
            </div>
            <div id="fishHotspotsStatus" class="text-sm text-base-content/60 mt-3 hidden"></div>
            <div id="fishHotspotsResults" class="mt-3 overflow-x-auto hidden">
                <table class="table table-zebra table-sm">
                    <thead>
                        <tr>
                            <th data-i18n="market.fish.title">Fish</th>
                            <th data-i18n="market.table.price">Price</th>
                            <th data-i18n="market.table.city">City</th>
                        </tr>
                    </thead>
                    <tbody id="fishHotspotsTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Roadmap notice -->
    <div class="card bg-base-200/50 border border-dashed border-base-content/10">
        <div class="card-body py-4">
            <div class="flex items-center gap-2">
                <span data-i18n="market.dev.badge" class="badge badge-warning badge-sm">In development</span>
                <p data-i18n="market.dev.text" class="text-xs text-base-content/50">
                    More resources, regions and price comparisons are on their way to this tab.
                </p>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts/market"}}
<!-- Market page: register with PageController for proper lifecycle management -->
<script>
    (async function () {
        const {registerPage, reinitCurrentPage} = await import('/scripts/core/PageController.js');

        const listeners = [];
        function addListener(el, event, handler) {
            if (el) {
                el.addEventListener(event, handler);
                listeners.push(() => el.removeEventListener(event, handler));
            }
        }

        function formatResourceLabel(entry) {
            const enchantSuffix = entry.enchant > 0 ? `.${entry.enchant}` : '';
            return `${entry.resource} T${entry.tier}${enchantSuffix}`;
        }

        function renderPriceTable(tableBody, entries) {
            tableBody.innerHTML = '';
            entries.forEach((entry, index) => {
                const row = document.createElement('tr');
                // Entries arrive sorted highest price first — highlight the top
                // result so the best price doesn't require reading every row.
                if (index === 0) row.classList.add('bg-warning/20', 'font-semibold');
                const resourceCell = document.createElement('td');
                resourceCell.textContent = formatResourceLabel(entry);
                const priceCell = document.createElement('td');
                priceCell.textContent = entry.price;
                const cityCell = document.createElement('td');
                cityCell.textContent = entry.city;
                row.append(resourceCell, priceCell, cityCell);
                tableBody.appendChild(row);
            });
        }

        function renderCityTable(tableBody, rankings) {
            tableBody.innerHTML = '';
            rankings.forEach((ranking, index) => {
                const row = document.createElement('tr');
                if (index === 0) row.classList.add('bg-warning/20', 'font-semibold');
                const cityCell = document.createElement('td');
                cityCell.textContent = ranking.city;
                const priceCell = document.createElement('td');
                priceCell.textContent = Math.round(ranking.averagePrice);
                const samplesCell = document.createElement('td');
                samplesCell.textContent = ranking.sampleCount;
                row.append(cityCell, priceCell, samplesCell);
                tableBody.appendChild(row);
            });
        }

        function initMarketPage() {
            // Market route ("Calcular Rota")
            const calcRouteBtn = document.getElementById('calcRouteBtn');
            const marketRouteFilters = document.getElementById('marketRouteFilters');
            const marketRouteResourceFilter = document.getElementById('marketRouteResourceFilter');
            const marketRouteTierFilter = document.getElementById('marketRouteTierFilter');
            const marketRouteStatus = document.getElementById('marketRouteStatus');
            const marketRouteResults = document.getElementById('marketRouteResults');
            const marketRouteTableBody = document.getElementById('marketRouteTableBody');
            const bestCitiesStatus = document.getElementById('bestCitiesStatus');
            const bestCitiesResults = document.getElementById('bestCitiesResults');
            const bestCitiesTableBody = document.getElementById('bestCitiesTableBody');
            let lastRouteEntries = [];

            function applyRouteFilters() {
                const resource = marketRouteResourceFilter.value;
                const tierFilter = marketRouteTierFilter.value; // "" | "2.0" | "3.0" | ... | "8.1"

                const filtered = lastRouteEntries.filter(entry => {
                    if (resource && entry.resource !== resource) return false;
                    if (tierFilter) {
                        const [tier, enchant] = tierFilter.split('.').map(Number);
                        if (entry.tier !== tier || entry.enchant !== enchant) return false;
                    }
                    return true;
                });

                if (filtered.length === 0) {
                    marketRouteResults.classList.add('hidden');
                    marketRouteStatus.classList.remove('hidden');
                    marketRouteStatus.textContent = window.i18n.t('market.status.noResultsForFilter');
                    return;
                }
                renderPriceTable(marketRouteTableBody, filtered);
                marketRouteStatus.classList.add('hidden');
                marketRouteResults.classList.remove('hidden');
            }

            async function calculateRoute() {
                if (!calcRouteBtn) return;
                calcRouteBtn.disabled = true;
                marketRouteFilters.classList.add('hidden');
                marketRouteResults.classList.add('hidden');
                bestCitiesResults.classList.add('hidden');
                bestCitiesStatus.classList.add('hidden');
                marketRouteStatus.classList.remove('hidden');
                marketRouteStatus.textContent = window.i18n.t('market.status.searchingPrices');
                try {
                    const response = await fetch('/api/market/route');
                    if (!response.ok) throw new Error(`status ${response.status}`);
                    const entries = await response.json();
                    lastRouteEntries = entries || [];

                    if (lastRouteEntries.length === 0) {
                        marketRouteStatus.textContent = window.i18n.t('market.status.noPricesAvailable');
                        return;
                    }

                    marketRouteFilters.classList.remove('hidden');
                    applyRouteFilters();
                } catch (error) {
                    marketRouteStatus.textContent = window.i18n.t('market.status.fetchError');
                    window.logger?.error('SYSTEM', 'MarketRouteFetchFailed', {
                        error: error?.message || String(error),
                    });
                } finally {
                    calcRouteBtn.disabled = false;
                }
            }

            addListener(calcRouteBtn, 'click', calculateRoute);
            addListener(marketRouteResourceFilter, 'change', applyRouteFilters);
            addListener(marketRouteTierFilter, 'change', applyRouteFilters);

            // Best cities ("Melhor Cidade") — same underlying data, grouped by city average
            const calcCitiesBtn = document.getElementById('calcCitiesBtn');

            async function calculateBestCities() {
                if (!calcCitiesBtn) return;
                calcCitiesBtn.disabled = true;
                marketRouteFilters.classList.add('hidden');
                marketRouteResults.classList.add('hidden');
                bestCitiesResults.classList.add('hidden');
                bestCitiesStatus.classList.remove('hidden');
                bestCitiesStatus.textContent = window.i18n.t('market.status.searchingCities');
                try {
                    const response = await fetch('/api/market/cities');
                    if (!response.ok) throw new Error(`status ${response.status}`);
                    const rankings = await response.json();

                    if (!rankings || rankings.length === 0) {
                        bestCitiesStatus.textContent = window.i18n.t('market.status.noPricesAvailable');
                        return;
                    }

                    renderCityTable(bestCitiesTableBody, rankings);
                    bestCitiesStatus.classList.add('hidden');
                    bestCitiesResults.classList.remove('hidden');
                } catch (error) {
                    bestCitiesStatus.textContent = window.i18n.t('market.status.fetchError');
                    window.logger?.error('SYSTEM', 'BestCitiesFetchFailed', {
                        error: error?.message || String(error),
                    });
                } finally {
                    calcCitiesBtn.disabled = false;
                }
            }

            addListener(calcCitiesBtn, 'click', calculateBestCities);

            // Fish prices ("Buscar Peixe")
            const calcFishBtn = document.getElementById('calcFishBtn');
            const fishFilters = document.getElementById('fishFilters');
            const fishResourceFilter = document.getElementById('fishResourceFilter');
            const fishTierFilter = document.getElementById('fishTierFilter');
            const fishHotspotsStatus = document.getElementById('fishHotspotsStatus');
            const fishHotspotsResults = document.getElementById('fishHotspotsResults');
            const fishHotspotsTableBody = document.getElementById('fishHotspotsTableBody');
            let lastFishEntries = [];

            function applyFishFilters() {
                const resource = fishResourceFilter.value;
                const tier = fishTierFilter.value;

                const filtered = lastFishEntries.filter(entry => {
                    if (resource && entry.resource !== resource) return false;
                    if (tier && entry.tier !== Number(tier)) return false;
                    return true;
                });

                if (filtered.length === 0) {
                    fishHotspotsResults.classList.add('hidden');
                    fishHotspotsStatus.classList.remove('hidden');
                    fishHotspotsStatus.textContent = window.i18n.t('market.status.noResultsForFilter');
                    return;
                }
                renderPriceTable(fishHotspotsTableBody, filtered);
                fishHotspotsStatus.classList.add('hidden');
                fishHotspotsResults.classList.remove('hidden');
            }

            async function calculateFishPrices() {
                if (!calcFishBtn) return;
                calcFishBtn.disabled = true;
                fishFilters.classList.add('hidden');
                fishHotspotsResults.classList.add('hidden');
                fishHotspotsStatus.classList.remove('hidden');
                fishHotspotsStatus.textContent = window.i18n.t('market.status.searchingPrices');
                try {
                    const response = await fetch('/api/market/fish');
                    if (!response.ok) throw new Error(`status ${response.status}`);
                    const entries = await response.json();
                    lastFishEntries = entries || [];

                    if (lastFishEntries.length === 0) {
                        fishHotspotsStatus.textContent = window.i18n.t('market.status.noPricesAvailable');
                        return;
                    }

                    fishFilters.classList.remove('hidden');
                    applyFishFilters();
                } catch (error) {
                    fishHotspotsStatus.textContent = window.i18n.t('market.status.fetchError');
                    window.logger?.error('SYSTEM', 'FishPricesFetchFailed', {
                        error: error?.message || String(error),
                    });
                } finally {
                    calcFishBtn.disabled = false;
                }
            }

            addListener(calcFishBtn, 'click', calculateFishPrices);
            addListener(fishResourceFilter, 'change', applyFishFilters);
            addListener(fishTierFilter, 'change', applyFishFilters);
        }

        function destroyMarketPage() {
            listeners.forEach(fn => fn());
            listeners.length = 0;
        }

        // Register with PageController (only once per session)
        if (!window._marketPageRegistered) {
            registerPage('market', {
                init: initMarketPage,
                destroy: destroyMarketPage
            });
            window._marketPageRegistered = true;
        }

        window.onGlobalsReady(() => reinitCurrentPage());
    })();
</script>
{{end}}

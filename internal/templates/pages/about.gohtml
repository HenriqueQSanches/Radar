{{define "pages/about"}}
<div class="space-y-6">
    <div class="card bg-base-200">
        <div class="card-body">
            <h1 data-i18n="about.title" class="text-3xl font-bold text-base-content">About</h1>
            <p class="text-base-content/60 mt-2">OpenRadar <span class="font-mono">v{{.Version}}</span></p>
        </div>
    </div>

    <div class="card bg-base-200">
        <div class="card-body text-sm text-base-content/80 space-y-3">
            <p data-i18n="about.origin.body">
                A fork of OpenRadar, by Nouuu, MIT licensed. Bug fixes and additions by Henrique Sanches;
                the full list is in the README of the repository.
            </p>
            <p>
                <a href="https://github.com/HenriqueQSanches/Radar" target="_blank" rel="noopener" class="link link-primary">github.com/HenriqueQSanches/Radar</a>
                <span class="text-base-content/40 mx-2">|</span>
                <a href="https://github.com/Nouuu/Albion-Online-OpenRadar" target="_blank" rel="noopener" class="link">github.com/Nouuu/Albion-Online-OpenRadar</a>
            </p>
            <p data-i18n="about.data">
                Prices come from the Albion Online Data Project. Packet capture needs Npcap.
            </p>
            <p data-i18n="about.license" class="text-xs text-base-content/50">
                MIT license, kept from the original project. See LICENSE.
            </p>
        </div>
    </div>
</div>
{{end}}
